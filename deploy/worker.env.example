# Copy to deploy/worker.env with mode 0600. The current worker is strictly
# PAPER/BACKTEST and must not receive Delta API credentials.
EXECUTION_MODE=PAPER
DELTA_REGION=india
DELTA_ENV=testnet
PRODUCTION_WRITES_FORBIDDEN=true
DATABASE_SINGLE_PROCESS=false

# Must match an account bootstrapped after migrations and the API account UUID.
HMT_WORKER_ACCOUNT_ID=00000000-0000-0000-0000-000000000001
# Optional stable process identity; omit to mint a fresh UUID on each restart.
# HMT_WORKER_ID=00000000-0000-0000-0000-000000000002
HMT_WORKER_POLL_INTERVAL_MILLISECONDS=500
HMT_WORKER_FAILURE_BACKOFF_MILLISECONDS=2000
