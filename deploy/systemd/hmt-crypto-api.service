[Unit]
Description=HMT-Crypto operator control API
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=hmt-crypto
Group=hmt-crypto
WorkingDirectory=/opt/hmt-crypto
EnvironmentFile=/etc/hmt-crypto/api.env
ExecStart=/opt/hmt-crypto/.venv/bin/hmt-crypto-api
Restart=on-failure
RestartSec=5s
TimeoutStopSec=30s
KillSignal=SIGTERM
NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
RestrictRealtime=true
LockPersonality=true
MemoryDenyWriteExecute=true
CapabilityBoundingSet=
AmbientCapabilities=
SystemCallArchitectures=native
UMask=0077

[Install]
WantedBy=multi-user.target
