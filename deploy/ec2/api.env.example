# Copy to api.env on EC2 and chmod 0600. Never commit the populated file.
DATABASE_URL=postgresql+asyncpg://runtime-role:replace@session-pooler-host:5432/postgres?ssl=require
DATABASE_SINGLE_PROCESS=false

HMT_API_OPERATOR_PASSWORD_HASH='$argon2id$v=19$m=65536,t=3,p=4$replace$replace'
HMT_API_ALLOWED_ORIGIN=https://crypto.helpmetrade.club
HMT_API_COOKIE_SECURE=true
HMT_API_ALLOW_INSECURE_LOOPBACK=false
HMT_API_DATABASE_CONTROL_ENABLED=false
HMT_API_EMBED_PAPER_WORKER=false
# HMT_API_ACCOUNT_ID=00000000-0000-0000-0000-000000000001

HMT_API_SESSION_IDLE_SECONDS=900
HMT_API_SESSION_ABSOLUTE_SECONDS=28800
HMT_API_MAX_SESSIONS=8
HMT_API_LOGIN_ATTEMPTS_PER_FIVE_MINUTES=10
HMT_API_MAX_REQUEST_BYTES=32768

EXECUTION_MODE=PAPER
DELTA_REGION=india
DELTA_ENV=testnet
PRODUCTION_WRITES_FORBIDDEN=true
