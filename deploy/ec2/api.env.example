# Copy to api.env on EC2 and chmod 0600. Never commit the populated file.
DATABASE_URL=postgresql+asyncpg://hmt_crypto_app.<project-ref>:replace@session-pooler-host-from-dashboard:5432/postgres?ssl=require
DATABASE_CA_FILE=/run/secrets/supabase-prod-ca.crt
DATABASE_SINGLE_PROCESS=false

HMT_API_OPERATOR_PASSWORD_HASH='$argon2id$v=19$m=65536,t=3,p=4$replace$replace'
HMT_API_ALLOWED_ORIGIN=https://crypto.helpmetrade.club
HMT_API_COOKIE_SECURE=true
HMT_API_ALLOW_INSECURE_LOOPBACK=false
HMT_API_DATABASE_CONTROL_ENABLED=true
HMT_API_EMBED_PAPER_WORKER=false
HMT_API_MULTI_USER_ENABLED=true
HMT_PRIVATE_READ_ONLY=true
HMT_SUPABASE_URL=https://<project-ref>.supabase.co
HMT_SUPABASE_PUBLISHABLE_KEY=sb_publishable_replace
HMT_SUPABASE_SECRET_KEY=sb_secret_replace
HMT_AWS_REGION=ap-south-1
# Match worker thresholds; alerts do not change execution gates.
HMT_RECOVERY_WARNING_SECONDS=15
HMT_RECOVERY_CRITICAL_SECONDS=60
# Conservative built-in ceilings remain in force unless explicitly configured.
# Review HMT_RISK_MAX_ORDER_NOTIONAL / HMT_RISK_MAX_POSITION_NOTIONAL and INR
# counterparts together; never increase them merely to silence a startup warning.
HMT_DELTA_SECRET_PREFIX=hmt-crypto/delta
# Bootstrap/emergency control account. Normal access is assignment-scoped.
HMT_API_ACCOUNT_ID=00000000-0000-4000-8000-000000000001

HMT_API_SESSION_IDLE_SECONDS=900
HMT_API_SESSION_ABSOLUTE_SECONDS=28800
HMT_API_MAX_SESSIONS=8
HMT_API_LOGIN_ATTEMPTS_PER_FIVE_MINUTES=10
HMT_API_MAX_REQUEST_BYTES=32768

EXECUTION_MODE=LIVE
DELTA_REGION=india
DELTA_ENV=prod
PRODUCTION_WRITES_FORBIDDEN=true
