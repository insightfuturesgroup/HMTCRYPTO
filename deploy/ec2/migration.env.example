# Copy to migration.env on EC2 and chmod 0600. Use the Supabase direct owner
# connection, never the transaction pooler, for Alembic migrations.
# The distinct runtime URL is also required by migration admission so the
# migration owner can never be reused accidentally by the application.
DATABASE_URL=postgresql+asyncpg://runtime-role:replace@session-pooler-host:5432/postgres?ssl=require
DATABASE_MIGRATION_URL=postgresql+asyncpg://migration-owner:replace@direct-host:5432/postgres
