# Copy to migration.env on EC2 and chmod 0600. Use the Supabase direct owner
# connection, never the transaction pooler, for Alembic migrations.
# The distinct runtime URL is also required by migration admission so the
# migration owner can never be reused accidentally by the application.
DATABASE_URL=postgresql+asyncpg://hmt_crypto_app.<project-ref>:replace@session-pooler-host-from-dashboard:5432/postgres?ssl=require
DATABASE_MIGRATION_URL=postgresql+asyncpg://postgres:replace@db.<project-ref>.supabase.co:5432/postgres
DATABASE_MIGRATION_CA_FILE=/run/secrets/supabase-prod-ca.crt
