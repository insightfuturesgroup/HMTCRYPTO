# Copy to worker.env on EC2 and chmod 0600. The release-candidate worker is
# PAPER/BACKTEST-only and must not receive Delta credentials yet.
DATABASE_URL=postgresql+asyncpg://runtime-role:replace@session-pooler-host:5432/postgres?ssl=require
DATABASE_CA_FILE=/run/secrets/supabase-prod-ca.crt
DATABASE_SINGLE_PROCESS=false

EXECUTION_MODE=LIVE
DELTA_REGION=india
DELTA_ENV=prod
PRODUCTION_WRITES_FORBIDDEN=true

# Phase 1 public-market process. It owns no Delta credentials and performs no orders.
HMT_WORKER_KIND=market
HMT_MARKET_REFRESH_SECONDS=15
HMT_MARKET_CATALOGUE_SECONDS=900

# Required by the separate private-worker service. Credentials remain in AWS
# Secrets Manager and are fetched only by ARN through the EC2 instance role.
HMT_AWS_REGION=ap-southeast-2
HMT_DELTA_SECRET_PREFIX=hmt-crypto/delta
HMT_PRIVATE_INTERVAL_SECONDS=15
HMT_PRIVATE_LEASE_SECONDS=45

# Required only when HMT_WORKER_KIND=paper (legacy emergency compatibility).
# HMT_WORKER_ACCOUNT_ID=00000000-0000-0000-0000-000000000001
HMT_WORKER_POLL_INTERVAL_MILLISECONDS=500
HMT_WORKER_FAILURE_BACKOFF_MILLISECONDS=2000
