# Configuration defaults. Copy to .env and keep real credentials out of version control.
EXECUTION_MODE=PAPER
DELTA_REGION=india
DELTA_ENV=testnet

# Local SQLite is restricted to single-process PAPER/BACKTEST. Config/import is lazy.
DATABASE_URL=sqlite+aiosqlite:///./hmt_crypto.db
DATABASE_SINGLE_PROCESS=true
# LIVE or multiple writer processes require postgresql+asyncpg. Obtain actual URLs
# from the deployment; never construct Supabase hostnames. Keep migration ownership
# separate and use a direct connection for Alembic (configured in a later unit).
# DATABASE_MIGRATION_URL=postgresql+asyncpg://owner:password@host/database

# Optional public-only local/dev REST endpoint. Both values are required together,
# DELTA_ENV must remain testnet, and EXECUTION_MODE=LIVE is rejected.
DELTA_ALLOW_DEVELOPMENT_ENDPOINT_OVERRIDE=false
# DELTA_DEVELOPMENT_REST_BASE_URL=http://127.0.0.1:8001

# LIVE requires every gate below and one credential source in the selected slot.
# This also applies to testnet LIVE. Production writes remain forbidden by default;
# testnet write dispatch is activated only after the testnet contract check described
# in docs/DELTA_CONTRACTS.md has been completed with your own key.
DELTA_LIVE_TRADING_ENABLED=false
# DELTA_LIVE_CONFIRMATION=I_UNDERSTAND_THIS_CAN_PLACE_REAL_ORDERS

# Configure either one complete inline pair or one credential file per selected slot.
# Credential files are absolute-path JSON objects containing exactly api_key and
# api_secret, must be owned by the service user, regular, non-symlinked, single-link,
# no larger than 4096 bytes, and have no group/other permissions (0600 recommended).
# Slots may coexist; only the selected slot is used. Never configure both source forms.
# DELTA_INDIA_TESTNET_API_KEY=
# DELTA_INDIA_TESTNET_API_SECRET=
# DELTA_INDIA_TESTNET_CREDENTIAL_FILE=/run/secrets/delta-india-testnet.json
# DELTA_INDIA_PROD_API_KEY=
# DELTA_INDIA_PROD_API_SECRET=
# DELTA_INDIA_PROD_CREDENTIAL_FILE=/run/secrets/delta-india-prod.json
# DELTA_GLOBAL_TESTNET_API_KEY=
# DELTA_GLOBAL_TESTNET_API_SECRET=
# DELTA_GLOBAL_TESTNET_CREDENTIAL_FILE=/run/secrets/delta-global-testnet.json
# DELTA_GLOBAL_PROD_API_KEY=
# DELTA_GLOBAL_PROD_API_SECRET=
# DELTA_GLOBAL_PROD_CREDENTIAL_FILE=/run/secrets/delta-global-prod.json
# Generic DELTA_API_KEY / DELTA_API_SECRET and unknown DELTA_* names are rejected.

# Tests force this flag on independently of local configuration. Keep it true until
# a separately reviewed go-live ceremony explicitly changes the deployment policy.
PRODUCTION_WRITES_FORBIDDEN=true

# Operator API. Generate an Argon2id hash locally; never store the plaintext password.
# Example command (after installation):
#   python -c 'from argon2 import PasswordHasher; print(PasswordHasher().hash(input()))'
# HMT_API_OPERATOR_PASSWORD_HASH=$argon2id$v=19$m=65536,t=3,p=4$...
HMT_API_ALLOWED_ORIGIN=http://127.0.0.1:5173
HMT_API_BIND_HOST=127.0.0.1
HMT_API_BIND_PORT=8000
HMT_API_COOKIE_SECURE=false
HMT_API_ALLOW_INSECURE_LOOPBACK=true
HMT_API_SESSION_IDLE_SECONDS=900
HMT_API_SESSION_ABSOLUTE_SECONDS=28800
HMT_API_MAX_SESSIONS=8
HMT_API_LOGIN_ATTEMPTS_PER_FIVE_MINUTES=10
HMT_API_MAX_REQUEST_BYTES=32768
# Disabled keeps dashboard/commands fail-closed. Enable only after migrations and
# account bootstrap; the UUID must match the selected region/environment/mode row.
HMT_API_DATABASE_CONTROL_ENABLED=false
# Local single-process SQLite preview only. Production/Postgres uses the
# separately deployed hmt-crypto-worker service.
HMT_API_EMBED_PAPER_WORKER=false
# HMT_API_ACCOUNT_ID=00000000-0000-0000-0000-000000000001

# Supabase is PostgreSQL hosting only for the Python worker/API. Obtain both exact
# URLs from the Supabase dashboard; do not guess hostnames. Use the session pooler
# for DATABASE_URL and a direct owner connection for DATABASE_MIGRATION_URL.
# DATABASE_URL=postgresql+asyncpg://runtime-role:password@pooler-host:5432/postgres?ssl=require
# DATABASE_MIGRATION_URL=postgresql+asyncpg://migration-owner:password@direct-host:5432/postgres
# DATABASE_MIGRATION_CA_FILE=/run/secrets/supabase-ca.pem

# Optional alert transport (not required for tests). Add only one after the
# deployment recipient and secret-storage policy are approved.
# HMT_ALERT_TELEGRAM_BOT_TOKEN_FILE=/run/secrets/telegram-bot-token
# HMT_ALERT_TELEGRAM_CHAT_ID=
# HMT_ALERT_EMAIL_WEBHOOK_URL_FILE=/run/secrets/email-webhook-url
