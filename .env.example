# Configuration defaults. Copy to .env and keep real credentials out of version control.
EXECUTION_MODE=PAPER
DELTA_REGION=india
DELTA_ENV=testnet

# Local SQLite is restricted to single-process PAPER/BACKTEST. Config/import is lazy.
DATABASE_URL=sqlite+aiosqlite:///./hmt_crypto.db
DATABASE_SINGLE_PROCESS=true
# LIVE or multiple writer processes require postgresql+asyncpg. Obtain actual URLs
# from the deployment; never construct Supabase hostnames. Keep migration ownership
# separate and use a direct connection for Alembic (configured in a later unit).
# DATABASE_MIGRATION_URL=postgresql+asyncpg://owner:password@host/database

# Optional public-only local/dev REST endpoint. Both values are required together,
# DELTA_ENV must remain testnet, and EXECUTION_MODE=LIVE is rejected.
DELTA_ALLOW_DEVELOPMENT_ENDPOINT_OVERRIDE=false
# DELTA_DEVELOPMENT_REST_BASE_URL=http://127.0.0.1:8001

# LIVE requires every gate below and both credentials in the selected slot.
# This also applies to testnet LIVE. Phase 1 never authorizes order writes:
# live_config_ready only reports configuration readiness; order_write_capable is false.
DELTA_LIVE_TRADING_ENABLED=false
# DELTA_LIVE_CONFIRMATION=I_UNDERSTAND_THIS_CAN_PLACE_REAL_ORDERS

# Configure complete pairs only. Slots may coexist; only the selected slot is used.
# DELTA_INDIA_TESTNET_API_KEY=
# DELTA_INDIA_TESTNET_API_SECRET=
# DELTA_INDIA_PROD_API_KEY=
# DELTA_INDIA_PROD_API_SECRET=
# DELTA_GLOBAL_TESTNET_API_KEY=
# DELTA_GLOBAL_TESTNET_API_SECRET=
# DELTA_GLOBAL_PROD_API_KEY=
# DELTA_GLOBAL_PROD_API_SECRET=
# Generic DELTA_API_KEY / DELTA_API_SECRET and unknown DELTA_* names are rejected.

# Tests force this flag on independently of local configuration.
PRODUCTION_WRITES_FORBIDDEN=true
